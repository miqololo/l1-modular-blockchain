# aios Phase 0.5 — environment for docker compose
# Copy to .env and customize. .env is gitignored.

# ─── Model ────────────────────────────────────────────────────────────────
# TinyLlama 1.1B Chat Q4_K_M (~700MB). Override the mirror if you have a faster
# nearby source. The SHA-256 is verified — mismatched files are rejected.
MODEL_MIRROR_URL=https://huggingface.co/TheBloke/TinyLlama-1.1B-Chat-v1.0-GGUF/resolve/main/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
# SHA-256 of the model file. The chain uses this to register the demo
# verification domain; the inference-node uses it (or computes its own from
# the model file) to populate attestations. They MUST match for the chain to
# accept submissions on verified services.
#
# Phase 1: pinned to the observed SHA of TheBloke/TinyLlama-1.1B-Chat-v1.0-GGUF
# Q4_K_M. Leave blank to fall back to "unverified-tinyllama-q4" (Phase 0.5).
MODEL_SHA256=9fecc3b3cd76bba89d504f29b616eedf7da85b96540e490ca5824d3f7d2776a0

# ─── Chain ────────────────────────────────────────────────────────────────
CHAIN_ID=aios-devnet-1
CHAIN_RPC_PORT=26657
CHAIN_REST_PORT=1317
CHAIN_GRPC_PORT=9090

# ─── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_PORT=5432

# ─── llama-server ─────────────────────────────────────────────────────────
LLAMA_PORT=8080
LLAMA_PORT_B=8082

# ─── indexer ──────────────────────────────────────────────────────────────
INDEXER_PORT=8081

# ─── frontend ─────────────────────────────────────────────────────────────
FRONTEND_PORT=3030
HARNESS_PORT=8090
# MVP item #2: second independent watcher, runs in parallel with the first.
HARNESS_PORT_B=8091
